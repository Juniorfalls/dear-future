/media/
/outputs/
/audio/

# local Python env for the TTS pipeline
.venv/

# third-party stickman skill (auto-cloned by make_horror_stickman.py)
/vendor/

# Kokoro voice model cache and sound-effect cache
.voice-models/
.sfxcache/

# director/writer checkpoints
*.written.json

# pre-polish narration backups
*.prepolish.json

# stickman render logs
stickman-render.log
playwright-install.log
stickman-render.pid
playwright-install.pid

# interrupted media downloads
*.part

# rendered output: stickman test film (and legacy clips). The active test MP4
